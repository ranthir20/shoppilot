generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id             Int             @id @default(autoincrement())
  name           String
  category       String
  price          Float
  stock          Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  userId         String
  returnItems    ReturnItem[]
  saleItems      SaleItem[]
  stockMovements StockMovement[]

  @@index([userId])
}

model Customer {
  id             Int       @id @default(autoincrement())
  name           String
  phone          String
  totalPurchases Float     @default(0)
  totalPaid      Float     @default(0)
  totalDue       Float     @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  userId         String
  payments       Payment[]
  sales          Sale[]

  @@index([userId])
}

model Sale {
  id          Int             @id @default(autoincrement())
  customerId  Int?
  totalAmount Float
  paidAmount  Float           @default(0)
  dueAmount   Float           @default(0)
  createdAt   DateTime        @default(now())
  userId      String
  returns     ProductReturn[]
  customer    Customer?       @relation(fields: [customerId], references: [id])
  items       SaleItem[]

  @@index([userId])
}

model SaleItem {
  id        Int     @id @default(autoincrement())
  saleId    Int
  productId Int
  quantity  Int
  price     Float
  total     Float
  product   Product @relation(fields: [productId], references: [id])
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
}

model Payment {
  id         Int      @id @default(autoincrement())
  customerId Int
  amount     Float
  createdAt  DateTime @default(now())
  userId     String
  customer   Customer @relation(fields: [customerId], references: [id])

  @@index([userId])
}

model StockMovement {
  id        Int      @id @default(autoincrement())
  userId    String
  productId Int
  type      String
  quantity  Int
  reason    String?
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([productId])
  @@index([createdAt])
}

model ProductReturn {
  id              Int          @id @default(autoincrement())
  userId          String
  saleId          Int
  totalAmount     Float
  createdAt       DateTime     @default(now())
  refundMethod    String       @default("CASH")
  refundReference String?
  refundStatus    String       @default("COMPLETED")
  sale            Sale         @relation(fields: [saleId], references: [id])
  items           ReturnItem[]

  @@index([userId])
  @@index([saleId])
  @@index([createdAt])
}

model ReturnItem {
  id        Int           @id @default(autoincrement())
  returnId  Int
  productId Int
  quantity  Int
  price     Float
  total     Float
  product   Product       @relation(fields: [productId], references: [id])
  return    ProductReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)

  @@index([returnId])
  @@index([productId])
}
